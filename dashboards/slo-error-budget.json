        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(sum_over_time(service_slo:sli_bad:rate5m{service=\"$service\", slo=\"$slo\"}[30d])) / sum(sum_over_time(service_slo:sli_total:rate5m{service=\"$service\", slo=\"$slo\"}[30d])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
