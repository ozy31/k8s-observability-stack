        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        }
      },
      {
        "type": "query",
        "name": "slo",
        "label": "SLO",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(service_slo:error_budget:ratio{service=\"$service\"}, slo)",
        "query": {
          "query": "label_values(service_slo:error_budget:ratio{service=\"$service\"}, slo)",
          "refId": "Var-slo"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {
          "selected": true,
          "text": "",
          "value": ""
