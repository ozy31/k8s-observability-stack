      "targets": [
        {
          "refId": "A",
          "expr": "730 * $node_hourly_price * (0.5 * sum(((sum by (namespace) (kube_pod_container_resource_requests{resource=\"cpu\", cluster=~\"$cluster\"} * on (cluster, namespace, pod) group_left () max by (cluster, namespace, pod) (kube_pod_status_phase{phase=~\"Running|Pending\", cluster=~\"$cluster\"} == 1))) >= (sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\", image!=\"\", cluster=~\"$cluster\"}[$__rate_interval])))) or (sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\", image!=\"\", cluster=~\"$cluster\"}[$__rate_interval])))) / $node_vcpu + 0.5 * sum(((sum by (namespace) (kube_pod_container_resource_requests{resource=\"memory\", cluster=~\"$cluster\"} * on (cluster, namespace, pod) group_left () max by (cluster, namespace, pod) (kube_pod_status_phase{phase=~\"Running|Pending\", cluster=~\"$cluster\"} == 1))) >= (sum by (namespace) (container_memory_working_set_bytes{container!=\"\", image!=\"\", cluster=~\"$cluster\"}))) or (sum by (namespace) (container_memory_working_set_bytes{container!=\"\", image!=\"\", cluster=~\"$cluster\"}))) / ($node_memory_gib * 1024 * 1024 * 1024))",
